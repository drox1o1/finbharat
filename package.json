{
  "name": "finbharat-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-content.mjs && vite build && vite build --ssr scripts/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "cms:package": "node scripts/package-cms.mjs",
    "test:cms-browser": "node tests/cms-browser.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.8",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "entities": "^8.1.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/cli": "^0.1.21",
    "@vitejs/plugin-react": "^4.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "sharp": "^0.35.5",
    "vite": "^6.3.0"
  }
}
