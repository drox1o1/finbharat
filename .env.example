# Vercel build environment. Do not put CMS credentials or deploy hooks in VITE_*.
CMS_URL=https://your-wordpress-host.example
SITE_URL=https://your-confirmed-domain.in
# Set to 1 in Vercel Production only; leave unset or 0 in Preview.
# Production also checks VERCEL_ENV / VERCEL_TARGET_ENV automatically.
PRODUCTION_LAUNCH=1
# Local CMS check only, optional: compare a running website to current CMS content.
# WEBSITE_URL=http://localhost:4173
